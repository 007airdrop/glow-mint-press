# Wallet that will deploy. NEVER commit a real key.
PRIVATE_KEY=0xyourprivatekey

# RPC endpoints (defaults to public Base endpoints if omitted)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Basescan API key for verification (https://basescan.org/myapikey)
BASESCAN_API_KEY=

# Metadata base URI passed to the constructor.
# Pin /metadata/*.json to IPFS first, then set:
#   METADATA_BASE_URI=ipfs://<CID>/{id}.json
METADATA_BASE_URI=ipfs://REPLACE_WITH_CID/{id}.json
